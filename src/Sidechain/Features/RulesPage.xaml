<Page x:Class="Sidechain.Features.RulesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:Sidechain.Shell"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,12,24,24" MaxWidth="960">
            <Grid>
                <ui:TextBlock FontTypography="Title" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{l:T Page.Rules}" />
                <ui:Button x:Name="AddButton" Content="{l:T Rules.Add}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <ui:TextBlock Appearance="Secondary" Text="{l:T Rules.Subtitle}" Margin="0,4,0,16" TextWrapping="Wrap" />
            <ui:InfoBar x:Name="ListError" Severity="Error" Margin="0,0,0,8" />
            <StackPanel x:Name="RuleList" />

            <Border x:Name="Editor" Visibility="Collapsed" Margin="0,12,0,0" Padding="20,16" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel>
                    <ui:TextBlock x:Name="EditorTitle" FontTypography="Subtitle" Margin="0,0,0,12" />

                    <ui:TextBlock Text="{l:T Rules.Triggers}" FontTypography="BodyStrong" />
                    <ui:TextBlock Text="{l:T Rules.Triggers.Note}" FontTypography="Caption" Appearance="Secondary" Margin="0,0,0,6" />
                    <WrapPanel x:Name="TriggerChips">
                        <ComboBox x:Name="TriggerPick" IsEditable="True" Width="240" Margin="0,0,6,6" />
                        <ui:Button x:Name="TriggerAdd" Content="{l:T Rules.AddApp}" Margin="0,0,6,6" />
                    </WrapPanel>
                    <ui:TextBlock x:Name="TriggerError" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed" />

                    <ui:TextBlock Text="{l:T Rules.Targets}" FontTypography="BodyStrong" Margin="0,8,0,0" />
                    <ui:TextBlock Text="{l:T Rules.Targets.Note}" FontTypography="Caption" Appearance="Secondary" Margin="0,0,0,6" />
                    <WrapPanel x:Name="TargetChips">
                        <ComboBox x:Name="TargetPick" IsEditable="True" Width="240" Margin="0,0,6,6" />
                        <ui:Button x:Name="TargetAdd" Content="{l:T Rules.AddApp}" Margin="0,0,6,6" />
                        <ui:Button x:Name="AllOthersAdd" Content="{l:T Rules.AllOthers}" Margin="0,0,6,6" />
                    </WrapPanel>
                    <ui:TextBlock x:Name="TargetError" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Grid>
                                <ui:TextBlock Text="{l:T Rules.Threshold}" FontTypography="BodyStrong" />
                                <ui:TextBlock x:Name="ThresholdText" HorizontalAlignment="Right" />
                            </Grid>
                            <ui:TextBlock Text="{l:T Rules.Threshold.Note}" FontTypography="Caption" Appearance="Secondary" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <Grid x:Name="MeterBox" Height="12" Margin="6,0,6,0">
                                <ProgressBar x:Name="TriggerMeter" Maximum="1" Height="8" VerticalAlignment="Center" />
                                <Canvas>
                                    <Rectangle x:Name="ThresholdLine" Width="3" Height="12" Fill="{DynamicResource SystemFillColorCautionBrush}" />
                                </Canvas>
                            </Grid>
                            <Slider x:Name="ThresholdSlider" Minimum="-70" Maximum="0" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="1" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Grid>
                                <ui:TextBlock Text="{l:T Rules.Depth}" FontTypography="BodyStrong" />
                                <ui:TextBlock x:Name="DepthText" HorizontalAlignment="Right" />
                            </Grid>
                            <ui:TextBlock Text="{l:T Rules.Depth.Note}" FontTypography="Caption" Appearance="Secondary" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <Slider x:Name="DepthSlider" Minimum="3" Maximum="30" SmallChange="1" LargeChange="3" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,12,0,0" />
                        </StackPanel>
                    </Grid>

                    <Expander x:Name="TimingBox" Header="{l:T Rules.Timing}" Margin="0,12,0,0">
                        <UniformGrid Columns="3" Margin="0,8,0,0">
                            <StackPanel Margin="0,0,12,0">
                                <ui:TextBlock Text="{l:T Rules.Attack}" FontTypography="Caption" />
                                <ui:NumberBox x:Name="AttackBox" Minimum="5" Maximum="2000" SmallChange="10" MaxDecimalPlaces="0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <ui:TextBlock Text="{l:T Rules.Hold}" FontTypography="Caption" />
                                <ui:NumberBox x:Name="HoldBox" Minimum="0" Maximum="5000" SmallChange="50" MaxDecimalPlaces="0" />
                            </StackPanel>
                            <StackPanel>
                                <ui:TextBlock Text="{l:T Rules.Release}" FontTypography="Caption" />
                                <ui:NumberBox x:Name="ReleaseBox" Minimum="20" Maximum="10000" SmallChange="50" MaxDecimalPlaces="0" />
                            </StackPanel>
                        </UniformGrid>
                    </Expander>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <ui:Button x:Name="SaveButton" Content="{l:T Rules.Save}" Appearance="Primary" />
                        <ui:Button x:Name="CancelButton" Content="{l:T Rules.Cancel}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
