<Page x:Class="Sidechain.Features.DevicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:Sidechain.Shell"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,12,24,24" MaxWidth="960">
            <ui:TextBlock FontTypography="Title" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{l:T Page.Devices}" />
            <ui:TextBlock Appearance="Secondary" Text="{l:T Devices.Subtitle}" Margin="0,4,0,16" TextWrapping="Wrap" />

            <ui:InfoBar x:Name="UndoBar" Severity="Informational" IsClosable="True" Margin="0,0,0,8" Title="{l:T Devices.Undo.Title}">
                <ui:Button x:Name="UndoButton" Content="{l:T Devices.Undo}" />
            </ui:InfoBar>
            <ui:InfoBar x:Name="MainBar" Severity="Informational" IsClosable="False" Margin="0,0,0,8" Title="{l:T Devices.NotListed.Title}">
                <ui:Button x:Name="MainButton" Content="{l:T Devices.MakeMain}" />
            </ui:InfoBar>
            <ui:InfoBar x:Name="ProblemBar" Severity="Warning" IsClosable="False" Margin="0,0,0,8" />

            <ui:CardControl Header="{l:T Devices.Pin}" Icon="{ui:SymbolIcon Pin24}" Margin="0,0,0,4">
                <ui:ToggleSwitch x:Name="PinSwitch" />
            </ui:CardControl>
            <ui:CardControl Icon="{ui:SymbolIcon CallForward24}" Margin="0,0,0,16">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="{l:T Devices.Comm}" />
                        <ui:TextBlock Text="{l:T Devices.Comm.Note}" FontTypography="Caption" Appearance="Secondary" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <CheckBox x:Name="CommBox" />
            </ui:CardControl>

            <ui:TextBlock Text="{l:T Devices.Priority}" FontTypography="BodyStrong" Margin="0,0,0,6" />
            <StackPanel x:Name="PriorityList" />
            <ui:TextBlock x:Name="OthersTitle" Text="{l:T Devices.Others}" FontTypography="BodyStrong" Margin="0,16,0,6" />
            <StackPanel x:Name="OtherList" />

            <ui:TextBlock Text="{l:T Devices.Log}" FontTypography="BodyStrong" Margin="0,16,0,6" />
            <ui:TextBlock x:Name="LogEmpty" Text="{l:T Devices.Log.Empty}" Appearance="Tertiary" />
            <StackPanel x:Name="LogList" />
        </StackPanel>
    </ScrollViewer>
</Page>
